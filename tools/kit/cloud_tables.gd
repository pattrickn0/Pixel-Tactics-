## Linha de MASSES com esse nome (vazio se não existe).
static func find_mass(mass_name: String) -> Dictionary:
	for mass: Dictionary in MASSES:
		if str(mass["name"]) == mass_name:
			return mass
	return {}


## Transformação no mundo de uma linha de INSTANCES (yaw em Y e escala uniforme).
static func instance_transform(inst: Array) -> Transform3D:
	var s: float = float(inst[4])
	var basis := Basis(Vector3.UP, deg_to_rad(float(inst[3]))).scaled(Vector3(s, s, s))
	return Transform3D(basis, inst[2] as Vector3)
